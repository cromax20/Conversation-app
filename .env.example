# --- Base de données (Neon / Vercel Postgres) ---
# URL « pooled » pour l'application, URL directe pour les migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth.js ---
# Générer avec : openssl rand -base64 32
AUTH_SECRET=""
# Connexion Google (console.cloud.google.com → Identifiants → ID client OAuth)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Liens magiques par e-mail (resend.com)
AUTH_RESEND_KEY=""
EMAIL_FROM="Alomundo <connexion@votre-domaine.com>"

# --- Claude (console.anthropic.com) ---
ANTHROPIC_API_KEY=""
# Modèles des personnages par formule (valeurs par défaut ci-dessous)
# MODEL_FREE="claude-haiku-5-5"
# MODEL_ESSENTIAL="claude-haiku-5-5"
# MODEL_PLUS="claude-sonnet-5-5"
# MODEL_PREMIUM="claude-opus-5-5"
# Petites tâches (traductions, phrases, cartes) et notation des épreuves
# MODEL_UTILITY="claude-haiku-5-5"
# MODEL_EXAM="claude-sonnet-5-5"

# --- Voix premium (platform.openai.com) ---
OPENAI_API_KEY=""

# --- Stripe (dashboard.stripe.com) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Identifiants des 6 prix Stripe (price_…) : une formule = un produit, avec un prix mensuel et un prix annuel
STRIPE_PRICE_ESSENTIAL_MONTHLY=""   # 7,99 € / mois
STRIPE_PRICE_ESSENTIAL_YEARLY=""    # 79 € / an
STRIPE_PRICE_PLUS_MONTHLY=""        # 12,99 € / mois (7 jours d'essai, une fois par compte)
STRIPE_PRICE_PLUS_YEARLY=""         # 129 € / an
STRIPE_PRICE_PREMIUM_MONTHLY=""     # 19,99 € / mois
STRIPE_PRICE_PREMIUM_YEARLY=""      # 199 € / an

# --- Limites ---
FREE_DAILY_REPLIES="10"
ESSENTIAL_DAILY_REPLIES="100"
PLUS_DAILY_REPLIES="100"
PREMIUM_DAILY_REPLIES="150"
# Niveau (validé par une épreuve) qui débloque l'appel vidéo gratuit : B2 ou C1
CALL_FREE_LEVEL="B2"
# Durée de l'appel gratuit hebdomadaire (minutes)
FREE_CALL_MINUTES="10"
# Cartes & quiz en version gratuite (par jour)
FREE_DAILY_CARDS="20"
FREE_DAILY_QUIZZES="3"
FREE_DAILY_DECKS="2"

# URL publique du site (sans / final)
APP_URL="http://localhost:3000"

# --- Économies ---
# Budget IA mensuel en euros : à 85 %, l'offre gratuite fait une pause (les abonnés continuent)
AI_MONTHLY_BUDGET_EUR="60"
# Mettre "1" pour bloquer aussi les abonnés une fois le budget atteint (déconseillé)
# AI_BUDGET_HARD_STOP="0"

# --- Croissance ---
# Coupon Stripe « offre de bienvenue » : pourcentage, durée « une fois » (= 1re année sur l'annuel)
STRIPE_COUPON_WELCOME=""
WELCOME_PERCENT="30"
WELCOME_HOURS="72"
# Coupon Stripe « parrainage » : montant fixe en EUR, durée « une fois »
STRIPE_COUPON_REFERRAL=""
REFERRAL_AMOUNT_EUR="10"
# Secret des tâches planifiées (relances par e-mail), à générer comme AUTH_SECRET
CRON_SECRET=""

# --- Tableau de bord du propriétaire (/admin) ---
ADMIN_EMAILS="vous@exemple.com"
FIXED_MONTHLY_COSTS_EUR="40"
SOCIAL_CHARGES_RATE="0.24"

# --- Sobriété ---
# Cache partagé des réponses de l'IA ("off" pour le désactiver)
# AI_CACHE="on"
# Durée de conservation sans utilisation (jours) : voix, puis textes
CACHE_AUDIO_DAYS="45"
CACHE_TEXT_DAYS="365"
